OPENAI_API_KEY=
ELASTICSEARCH_URL=http://localhost:9200
PROVENANCE_SERVICE_URL=http://127.0.0.1:8000

# Where Provenance sends its own traces (optional).
SENTRY_DSN=

# --- Integration backends (all optional) --------------------------------------
# Leave a group blank and that adapter keeps using seed/mock_integrations fixtures.
# Fill one in and only that adapter goes live. See provenance/integrations/_live.py.

# GitHub: a token with `repo` read scope, plus the repo the code lives in.
GITHUB_TOKEN=
GITHUB_REPO=

# Sentry issue lookup. Unrelated to SENTRY_DSN above -- this one *reads* issues.
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Jira: base URL, the account email, and an API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
