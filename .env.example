OPENAI_API_KEY=
ELASTICSEARCH_URL=http://localhost:9200
PROVENANCE_SERVICE_URL=http://127.0.0.1:8000

# --- Mock or real ---------------------------------------------------------------
# true  = the seed demo: fixture PRs, tickets and incidents, Slack read from an
#         export directory. No credentials beyond OPENAI_API_KEY.
# false = the real thing: GitHub, Jira and Sentry are called for real, and ingest
#         defaults to --source slack. Nothing falls back to a fixture, so an
#         unconfigured tracker contributes no nodes rather than fake ones.
#         GITHUB_TOKEN and GITHUB_REPO become required; the service refuses to boot
#         without them.
USE_MOCK_DATA=true

# --- Live Slack (ingest --source slack) ---------------------------------------
# The only value you fill in is SLACK_USER_TOKEN; team and channel default to the
# workspace this project indexes. Create the app from slack_app_manifest.yml,
# install it, then copy the User OAuth Token from "OAuth & Permissions".
# See the README, "Connecting to Slack". Blank token = live Slack is off.
SLACK_USER_TOKEN=

# Defaults match provenance/config.py; override only if you index elsewhere.
SLACK_TEAM_ID=T0C34UQUW68
SLACK_CHANNEL_IDS=C0C34DY037B
# 1 high, 2 normal, 3 low -- drives the channel weight at query time.
SLACK_CHANNEL_TIER=2
# Incremental re-reads threads whose parent is this recent; older ones need reconcile.
SLACK_THREAD_LOOKBACK_DAYS=14

# --- Slack bot (make slackbot) ------------------------------------------------
# Indexes one conversation on demand, from inside Slack. Only needed for the bot --
# live ingest above works without these. Both come from the same app; reinstall it
# from slack_app_manifest.yml to get them, and re-copy SLACK_USER_TOKEN afterwards.
#   OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=
#   Basic Information -> App-Level Tokens -> new token, scope `connections:write`
SLACK_APP_TOKEN=

# Where Provenance sends its own traces (optional).
SENTRY_DSN=

# --- Integration backends -------------------------------------------------------
# Only read when USE_MOCK_DATA=false. Leave a group blank there and that adapter
# answers nothing at all -- it does not quietly fall back to the fixtures. See
# provenance/integrations/_live.py.

# GitHub: a token with `repo` read scope, plus the repo the code lives in.
# Required when USE_MOCK_DATA=false.
GITHUB_TOKEN=
GITHUB_REPO=

# Sentry issue lookup. Unrelated to SENTRY_DSN above -- this one *reads* issues.
# The token needs `event:read` and `org:read`. Org and project are the two slugs in
# a Sentry URL: sentry.io/organizations/<org>/projects/<project>/
#
# PR -> incident is resolved through releases, not by searching issue text: the PR's
# merge_commit_sha (from GitHub) is the Sentry release version, so the lookup is
# `firstRelease:<sha>`. That requires the analysed repo to name its releases after
# the merge commit -- `getsentry/action-release` does by default. Without that
# workflow the lookups are simply empty. See provenance/integrations/sentry_issues.py
# and, for the other half, .github/workflows/sentry-release.yml in the target repo.
# GITHUB_TOKEN/GITHUB_REPO above are therefore required for incidents too.
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Jira: base URL, the account email, and an API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# --- Advanced overrides ---------------------------------------------------------
# Everything below has a working default in provenance/config.py. Leave these out
# unless you are pointing at a self-hosted instance or a recorded test fixture.

# API base URLs. Override for GitHub Enterprise, self-hosted Sentry, or a mock server.
# GITHUB_API=https://api.github.com
# SENTRY_API=https://sentry.io/api/0
# SLACK_API=https://slack.com/api

# Workspace name used to build permalinks for a Slack *export*, which carries none.
# Anything reading Slack live (ingest --source slack, the bot) overwrites it from
# auth.test at run time, so it only matters for --source export.
# SLACK_WORKSPACE=acme

# Per-channel tiers, overriding SLACK_CHANNEL_TIER for the channels named here.
# Keyed by channel NAME, not ID (a leading '#' is optional and ignored).
# Format: comma-separated <name>:<tier> pairs, tier 1 high / 2 normal / 3 low.
# SLACK_CHANNEL_TIERS=incidents:1,eng-backend:2,watercooler:3
