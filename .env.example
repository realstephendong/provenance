OPENAI_API_KEY=
ELASTICSEARCH_URL=http://localhost:9200
PROVENANCE_SERVICE_URL=http://127.0.0.1:8000

# --- Live Slack (ingest --source slack) ---------------------------------------
# The only value you fill in is SLACK_USER_TOKEN; team and channel default to the
# workspace this project indexes. Create the app from slack_app_manifest.yml,
# install it, then copy the User OAuth Token from "OAuth & Permissions".
# See the README, "Connecting to Slack". Blank token = live Slack is off.
SLACK_USER_TOKEN=

# Defaults match provenance/config.py; override only if you index elsewhere.
SLACK_TEAM_ID=T0C34UQUW68
SLACK_CHANNEL_IDS=C0C34DY037B
# 1 high, 2 normal, 3 low -- drives the channel weight at query time.
SLACK_CHANNEL_TIER=2
# Incremental re-reads threads whose parent is this recent; older ones need reconcile.
SLACK_THREAD_LOOKBACK_DAYS=14

# Where Provenance sends its own traces (optional).
SENTRY_DSN=

# --- Integration backends (all optional) --------------------------------------
# Leave a group blank and that adapter keeps using seed/mock_integrations fixtures.
# Fill one in and only that adapter goes live. See provenance/integrations/_live.py.

# GitHub: a token with `repo` read scope, plus the repo the code lives in.
GITHUB_TOKEN=
GITHUB_REPO=

# Sentry issue lookup. Unrelated to SENTRY_DSN above -- this one *reads* issues.
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Jira: base URL, the account email, and an API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
