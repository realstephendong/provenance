OPENAI_API_KEY=
ELASTICSEARCH_URL=http://localhost:9200
PROVENANCE_SERVICE_URL=http://127.0.0.1:8000
# Team Docker deployment only: leave as localhost until an authenticated reverse
# proxy or private-network gateway is in place. Do not expose the API publicly.
PROVENANCE_API_BIND=127.0.0.1:8000

# --- Mock or real ---------------------------------------------------------------
# true  = the seed demo: fixture PRs, tickets and incidents, Slack read from an
#         export directory. No credentials beyond OPENAI_API_KEY.
# false = the real thing: GitHub, Jira and Sentry are called for real, and ingest
#         defaults to --source slack. Nothing falls back to a fixture, so an
#         unconfigured tracker contributes no nodes rather than fake ones.
#         GITHUB_TOKEN and GITHUB_REPO become required; the service refuses to boot
#         without them.
USE_MOCK_DATA=true

# --- Shared Slack backfill (ingest --source slack) -----------------------------
# This uses the workspace bot credential and indexes approved *public* channels into
# shared Elasticsearch. It never uses a developer's browser OAuth token. Create the
# internal app from slack_app_manifest.yml, install it, then copy its Bot User OAuth
# Token from "OAuth & Permissions".
#
# SLACK_APP_TOKEN is needed only for `make slackbot` (Socket Mode), not bulk backfill.
SLACK_BOT_TOKEN=

# Defaults match provenance/config.py; override only if your workspace differs.
SLACK_TEAM_ID=
# Public channels the bot may add to the shared index. `*` lets it discover and join
# every public channel; private channels are never read by shared backfill.
SLACK_BOT_CHANNEL_IDS=*
# 1 high, 2 normal, 3 low -- drives the channel weight at query time.
SLACK_CHANNEL_TIER=2
# Incremental re-reads threads whose parent is this recent; older ones need reconcile.
SLACK_THREAD_LOOKBACK_DAYS=14
# Does the time between two messages mean a conversation ended in this workspace?
# True for a channel people wrote in over weeks. Set false for one that was seeded or
# bulk-posted, where every message is seconds from the next and no gap threshold can
# separate two conversations -- loose messages are then indexed one unit each instead
# of being merged into one blended unit. Threads are unaffected either way. `make
# ingest-slack` prints the evidence for your channel.
SEGMENT_TRUST_TIME=true

# --- Shared Slack bot (make slackbot) -----------------------------------------
# Deploy one long-running instance with these secrets and a shared Elasticsearch.
# Everyone in an allowed channel can invoke the shortcut or /provenance; no personal
# xoxp token is needed. Keep the allowlist limited to channels whose content may be
# retrieved by everyone who can access your shared Provenance service.
# Both tokens come from the workspace app in slack_app_manifest.yml.
#   OAuth & Permissions -> Bot User OAuth Token
# SLACK_BOT_TOKEN is declared above and is also used by shared bulk backfill.
#   Basic Information -> App-Level Tokens -> new token, scope `connections:write`
SLACK_APP_TOKEN=
# Comma-separated channel IDs the bot may index. Use * for every public channel; the
# bot joins a public channel on first use. Private channels always need an invite.
SLACK_BOT_CHANNEL_IDS=

# Where Provenance sends its own traces (optional).
SENTRY_DSN=

# --- Integration backends -------------------------------------------------------
# Only read when USE_MOCK_DATA=false. Leave a group blank there and that adapter
# answers nothing at all -- it does not quietly fall back to the fixtures. See
# provenance/integrations/_live.py.

# GitHub: preferred shared deployment uses a GitHub App. Set the App ID and the
# host path to its PEM key; Docker mounts it read-only into the API container.
# The extension detects each open repository from its git origin, so no repository
# slug or personal token is needed per developer.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
# Local (non-Docker) runs can use the same PEM path directly instead.
# GITHUB_APP_PRIVATE_KEY_PATH=/secure/path/provenance.private-key.pem

# Legacy fallback: a token with `repo` read scope and one fixed repository.
# Leave blank when using the GitHub App.
GITHUB_TOKEN=
GITHUB_REPO=

# Sentry issue lookup. Unrelated to SENTRY_DSN above -- this one *reads* issues.
# The token needs `event:read` and `org:read`. Org and project are the two slugs in
# a Sentry URL: sentry.io/organizations/<org>/projects/<project>/
#
# PR -> incident is resolved through releases, not by searching issue text: the PR's
# merge_commit_sha (from GitHub) is the Sentry release version, so the lookup is
# `firstRelease:<sha>`. That requires the analysed repo to name its releases after
# the merge commit -- `getsentry/action-release` does by default. Without that
# workflow the lookups are simply empty. See provenance/integrations/sentry_issues.py
# and, for the other half, .github/workflows/sentry-release.yml in the target repo.
# GITHUB_TOKEN/GITHUB_REPO above are therefore required for incidents too.
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Jira: base URL, the account email, and an API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# --- Advanced overrides ---------------------------------------------------------
# Everything below has a working default in provenance/config.py. Leave these out
# unless you are pointing at a self-hosted instance or a recorded test fixture.

# API base URLs. Override for GitHub Enterprise, self-hosted Sentry, or a mock server.
# GITHUB_API=https://api.github.com
# SENTRY_API=https://sentry.io/api/0
# SLACK_API=https://slack.com/api

# Workspace name used to build permalinks for a Slack *export*, which carries none.
# Anything reading Slack live (ingest --source slack, the bot) overwrites it from
# auth.test at run time, so it only matters for --source export.
# SLACK_WORKSPACE=acme

# Per-channel tiers, overriding SLACK_CHANNEL_TIER for the channels named here.
# Keyed by channel NAME, not ID (a leading '#' is optional and ignored).
# Format: comma-separated <name>:<tier> pairs, tier 1 high / 2 normal / 3 low.
# SLACK_CHANNEL_TIERS=incidents:1,eng-backend:2,watercooler:3

# --- The private half: your machine only -----------------------------------------
# A Backfill press indexes public channels into the shared Elasticsearch above, and
# the private channels you can read into an encrypted store on this machine. The
# Slack token for that half is yours, lives in your OS keychain, and is never in
# this file -- you grant it once through the browser.
#
# Copy both values from Slack app Settings -> Basic Information -> App Credentials.
# The client ID is public; the client secret is needed when Slack has configured the
# app as a confidential OAuth client. Keep the secret in your untracked .env file.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack matches the OAuth redirect URL exactly, so pin the connector's port to the
# one registered in slack_app_manifest.yml.
PROVENANCE_LOCAL_PORT=51737
# Where the encrypted store lives. Defaults to ~/.provenance.
PROVENANCE_LOCAL_DIR=
