__pycache__/
*.pyc
.venv/
# every local env file; .env.example is the one tracked template
.env*
!.env.example
# Deployment-only credentials, such as a GitHub App private key.
.secrets/
.es_storage/
# leftover from the pre-merge Qdrant build; safe to delete
.qdrant_storage/
# 'send to agent' output
.provenance/
node_modules/
extension/out/
extension/*.vsix
seed/repo/
seed/slack/
.pytest_cache/

# local graph previews (generated, not part of the build)
preview_*.html

# editable install metadata
*.egg-info/
