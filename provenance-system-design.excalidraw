    {"id":"privacyNote","type":"text","x":80,"y":650,"width":640,"height":105,"angle":0,"strokeColor":"#862e9c","backgroundColor":"#f8f0fc","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":23,"version":1,"versionNonce":23,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":{"type":3},"boundElements":null,"updated":0,"link":null,"locked":false,"text":"PRIVACY BOUNDARY\n• Browser OAuth token never enters .env, the API, or Elasticsearch\n• Local agent requests only Slack conversations marked private\n• Private search stays local; merged cards are labelled “Only visible to you”\n• Public/shared ingest uses the workspace bot credential only","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"PRIVACY BOUNDARY\n• Browser OAuth token never enters .env, the API, or Elasticsearch\n• Local agent requests only Slack conversations marked private\n• Private search stays local; merged cards are labelled “Only visible to you”\n• Public/shared ingest uses the workspace bot credential only","lineHeight":1.25},
